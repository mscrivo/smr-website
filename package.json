{
  "name": "smr-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing site for SMR Computer Services",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
