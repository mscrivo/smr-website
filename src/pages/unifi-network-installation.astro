---
import ServicePage from '../layouts/ServicePage.astro';
import Networks from '../components/Networks.astro';
import { site } from '../data/site';

const cities = site.cities.join(', ');

const steps = [
  {
    title: 'Walkthrough & coverage plan',
    text: 'I look at the space, where the internet comes in, and where you actually use Wi-Fi, then plan gateway, switch, and access point placement so every room gets a strong signal.',
  },
  {
    title: 'Install & wired backbone',
    text: 'Gateway, PoE switching, and access points go in, with a wired backbone wherever it’s practical, so Wi-Fi only carries the last hop.',
  },
  {
    title: 'Configure & test',
    text: 'Networks, Wi-Fi, guest access, and any cameras or doorbells are set up on a single UniFi controller, then tested room by room.',
  },
  {
    title: 'Ongoing management',
    text: 'If you’d like, I keep an eye on it afterwards — monitoring, firmware updates, and changes — from the same dashboard I use for every site I manage.',
  },
];

const faqs = [
  {
    q: 'Which areas do you serve?',
    a: `Homes and small businesses across Halton and Peel, including ${cities}.`,
  },
  {
    q: 'Is UniFi just for businesses?',
    a: 'No. UniFi works just as well in a house as in an office. It’s a good fit anywhere a single router can’t cover the whole space, or where you want Wi-Fi, cameras, and doorbells managed in one place.',
  },
  {
    q: 'Can you add cameras and a doorbell to the same system?',
    a: 'Yes. UniFi Protect cameras and doorbells run on the same controller as your network, so everything is viewed and managed from one app.',
  },
  {
    q: 'What happens after the install?',
    a: 'You get a network that’s documented and explained in plain language. I can also manage it on an ongoing basis — monitoring, updates, and changes as your needs grow.',
  },
];
---

<ServicePage
  title={`UniFi Network Installation in ${cities}`}
  description={`Ubiquiti UniFi network design, installation, and management for homes and small businesses in ${cities} and across Halton & Peel — whole-home Wi-Fi, PoE switching, cameras, and doorbells.`}
  eyebrow="Ubiquiti UniFi · Halton & Peel"
  heading={`UniFi network installation in ${cities}`}
  lead={`Wi-Fi that reaches every room, a wired backbone that doesn’t drop out, and one controller for your whole network — designed, installed, and managed by ${site.owner} of ${site.name}.`}
  cta="Plan your network"
  stepsTitle="From walkthrough to a network you don’t think about"
  steps={steps}
  faqs={faqs}
>
  <Networks />
</ServicePage>
