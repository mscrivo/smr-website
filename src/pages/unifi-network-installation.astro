---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Networks from '../components/Networks.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

const cities = site.cities.join(', ');

const steps = [
  {
    title: 'Walkthrough & coverage plan',
    text: 'I look at the space, where the internet comes in, and where you actually use Wi-Fi, then plan gateway, switch, and access point placement so every room gets a strong signal.',
  },
  {
    title: 'Install & wired backbone',
    text: 'Gateway, PoE switching, and access points go in, with a wired backbone wherever it’s practical, so Wi-Fi only carries the last hop.',
  },
  {
    title: 'Configure & test',
    text: 'Networks, Wi-Fi, guest access, and any cameras or doorbells are set up on a single UniFi controller, then tested room by room.',
  },
  {
    title: 'Ongoing management',
    text: 'If you’d like, I keep an eye on it afterwards — monitoring, firmware updates, and changes — from the same dashboard I use for every site I manage.',
  },
];

const faqs = [
  {
    q: 'Which areas do you serve?',
    a: `Homes and small businesses across Halton and Peel, including ${cities}.`,
  },
  {
    q: 'Is UniFi just for businesses?',
    a: 'No. UniFi works just as well in a house as in an office. It’s a good fit anywhere a single router can’t cover the whole space, or where you want Wi-Fi, cameras, and doorbells managed in one place.',
  },
  {
    q: 'Can you add cameras and a doorbell to the same system?',
    a: 'Yes. UniFi Protect cameras and doorbells run on the same controller as your network, so everything is viewed and managed from one app.',
  },
  {
    q: 'What happens after the install?',
    a: 'You get a network that’s documented and explained in plain language. I can also manage it on an ongoing basis — monitoring, updates, and changes as your needs grow.',
  },
];
---

<Layout
  title={`UniFi Network Installation in ${cities}`}
  description={`Ubiquiti UniFi network design, installation, and management for homes and small businesses in ${cities} and across Halton & Peel — whole-home Wi-Fi, PoE switching, cameras, and doorbells.`}
>
  <Header />
  <main>
    <section class="section intro">
      <div class="container">
        <span class="eyebrow">Ubiquiti UniFi · Halton &amp; Peel</span>
        <h1 class="page-title">UniFi network installation in {cities}</h1>
        <p class="section-lead">
          Wi-Fi that reaches every room, a wired backbone that doesn’t drop out, and one controller
          for your whole network — designed, installed, and managed by {site.owner} of {site.name}.
        </p>
        <a class="btn btn-primary cta" href="#contact">
          Plan your network
        </a>
      </div>
    </section>

    <Networks />

    <section class="section">
      <div class="container">
        <span class="eyebrow">How it works</span>
        <h2 class="section-title">From walkthrough to a network you don’t think about</h2>
        <ol class="steps">
          {steps.map((step) => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <span class="eyebrow">FAQ</span>
        <h2 class="section-title">Common questions</h2>
        <div class="faqs">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <Contact />
  </main>
  <Footer />
</Layout>

<style>
  .intro {
    padding-bottom: 0;
  }

  .page-title {
    font-size: clamp(2.1rem, 5.5vw, 3.4rem);
    margin-top: 1rem;
    max-width: 22ch;
  }

  .cta {
    margin-top: 2rem;
  }

  .steps {
    list-style: none;
    counter-reset: step;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .steps li {
    counter-increment: step;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .steps li::before {
    content: '0' counter(step);
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.85rem;
  }

  .steps h3 {
    font-size: 1.12rem;
    margin-top: 0.5rem;
  }

  .steps p,
  .faqs p {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-top: 0.6rem;
  }

  .faqs {
    margin-top: 2rem;
    display: grid;
    gap: 0.75rem;
    max-width: 72ch;
  }

  .faqs details {
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .faqs summary {
    cursor: pointer;
    font-weight: 600;
  }
</style>
