---
import { site } from '../data/site';
---

<section class="section about" id="about">
  <div class="container about-grid">
    <div>
      <span class="eyebrow">About</span>
      <h2 class="section-title">A local expert, not a call centre</h2>
      <p class="about-text">
        {site.name} is a sole proprietorship run by {site.owner}. You work directly with the person
        doing the job — no scripts, no runaround, no upselling. Just practical, honest technology
        help for people and businesses in the {site.region}.
      </p>
      <p class="about-text">
        Whether you need a new machine built from scratch, a network that finally reaches every
        room, cameras you can check from your phone, or custom software to cut out manual work, I’ll
        handle it end to end and explain everything in plain language.
      </p>
      <a class="btn btn-ghost" href={`mailto:${site.email}`}>Let’s talk about your project</a>
    </div>

    <ul class="stats">
      <li>
        <span class="stat-value">1:1</span>
        <span class="stat-label">Direct, personal service on every job</span>
      </li>
      <li>
        <span class="stat-value">GTA</span>
        <span class="stat-label">Based in &amp; serving the Greater Toronto Area</span>
      </li>
      <li>
        <span class="stat-value">6</span>
        <span class="stat-label">Core services under one roof</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .about-text {
    color: var(--text-muted);
    margin-top: 1.2rem;
    max-width: 56ch;
  }

  .about-grid .btn {
    margin-top: 1.8rem;
  }

  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .stats li {
    padding: 1.3rem 1.5rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }

  .stat-value {
    display: block;
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--accent);
  }

  .stat-label {
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
