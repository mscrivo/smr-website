---
// Grid of showcase cards (screenshot, name, summary, link) for service pages.
import type { Project } from '../data/site';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="projects">
  {projects.map((project) => (
    <article class="project">
      <a href={project.url}>
        <img src={project.image} width="1440" height="900" loading="lazy" alt={project.alt} />
      </a>
      <div class="project-body">
        <h3>{project.name}</h3>
        <p>{project.summary}</p>
        <a class="project-link" href={project.url}>
          Visit {project.url.replace('https://', '')} →
        </a>
      </div>
    </article>
  ))}
</div>

<style>
  .projects {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .project {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }

  .project img {
    width: 100%;
    height: auto;
    border-bottom: 1px solid var(--border);
  }

  .project-body {
    padding: 1.25rem 1.4rem 1.5rem;
  }

  .project h3 {
    font-size: 1.18rem;
  }

  .project p {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-top: 0.5rem;
  }

  .project-link {
    display: inline-block;
    margin-top: 0.9rem;
    font-weight: 600;
    font-size: 0.95rem;
  }
</style>
